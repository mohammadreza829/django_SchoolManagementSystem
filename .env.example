# نمونهٔ متغیرهای محیطی پروژه
# این فایل را کپی کن به .env و مقادیر واقعی را بگذار:
#   cp .env.example .env
# فایل .env در .gitignore است و هرگز نباید کامیت شود.

# ==================== جنگو ====================
# کلید را با این دستور بساز:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# برای پروداکشن با HTTPS، دامنه‌ها را با کاما جدا کن:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ==================== دیتابیس ====================
# postgresql (پیش‌فرض) یا sqlite برای اجرای سریع تست‌ها
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=eduplatform
DJANGO_DB_USER=eduplatform_admin
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ==================== دستیار هوش مصنوعی (TabiAI / tabitoken) ====================
AI_API_BASE_URL=https://tabitoken.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_DAILY_LIMIT=10

# ==================== درگاه پرداخت زرین‌پال ====================
# در حالت تستی (sandbox) می‌توانی merchant-id تستی زیر را نگه داری.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
# واحد مبلغ ارسالی به درگاه: IRR (ریال، پیش‌فرض) یا IRT (تومان)
ZARINPAL_CURRENCY=IRR
ZARINPAL_TIMEOUT_SECONDS=30
